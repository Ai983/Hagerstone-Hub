# Cursor IDE local config (contains API tokens — never commit)
.cursor/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.local
.env.*.local

# Auth import tool — contains bcrypt hashes and results, never commit
auth-import-tool/

# Operational runbooks — contain JWTs, project IDs, DB pooler hosts. Keep local.
BACKUP_RUNBOOK.md
HAGERSTONE_*.md

# Database backups + n8n workflow JSON exports — production data & credentials
backups/
n8n_backups_*/

# Supabase migrations: this project applies schema directly via MCP/dashboard,
# not via git-tracked migration files. Tracking them drifts from the remote
# 91-version history and fails the Supabase Preview check. Keep them out of git.
supabase/migrations/
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# MCP server config — contains secret tokens (Railway API token, etc.)
.mcp.json

# Local-only build/spec docs + generated reports — not part of the app, keep
# local so the working tree stays clean. (Some specs in "MARKDOWN FILES/" are
# already tracked; these are the untracked WIP/build docs we keep out of git.)
GIE-implementation-runbook.md
SPEC-HUB-GAMIFICATION.md
group-intelligence-engine-build-manual.html
MARKDOWN FILES/BUILD-RUNBOOK-DELEGATION.md
MARKDOWN FILES/FOUNDER_DASHBOARD.md
